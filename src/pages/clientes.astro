---
import snapshot from "../data/wp-snapshot.json";
import { applySiteHtml } from "../lib/site-html";

const shellPage = snapshot.pages.find((item) => item.path === "/") ?? snapshot.pages[0];
const bodyAttributes = shellPage.bodyAttributes ?? {};
const headHtmlToInject = shellPage.headHtml ?? "";
const shellBodyHtml = shellPage.bodyHtml ?? "";
const mainMarker = '<div id="pxl-main">';
const footerMarker = '<footer id="pxl-footer-elementor"';
const mainIndex = shellBodyHtml.indexOf(mainMarker);
const footerIndex = shellBodyHtml.indexOf(footerMarker);
const headerHtmlToInject = applySiteHtml(mainIndex >= 0 ? shellBodyHtml.slice(0, mainIndex) : "");
const footerHtmlToInject = applySiteHtml(footerIndex >= 0 ? shellBodyHtml.slice(footerIndex) : "");
---

<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={headHtmlToInject} />
    <title>Clientes | DIICSA</title>
    <meta
      name="description"
      content="Hemos colaborado con corporativos, plantas industriales, centros de entrenamiento y empresas que requieren continuidad, seguridad y respuesta tecnica."
    />
    <style is:global>
      #pxl-header-elementor .pxl-header-elementor-sticky,
      #pxl-header-elementor.pxl-header-fixed,
      #pxl-header-elementor.pxl-header-sticky {
        display: none !important;
      }

      #pxl-header-elementor .elementor-widget-pxl_logo,
      #pxl-header-elementor .pxl-logo,
      #pxl-header-elementor .pxl-logo a {
        width: 180px !important;
        min-width: 180px !important;
        max-width: none !important;
      }

      #pxl-header-elementor .pxl-logo img,
      #pxl-header-elementor img.diicsa-header-logo,
      #pxl-header-elementor img[src*="diccsA.png"] {
        display: block !important;
        width: 180px !important;
        height: 180px !important;
        min-width: 180px !important;
        min-height: 180px !important;
        max-width: none !important;
        max-height: none !important;
        object-fit: contain !important;
      }

      #pxl-header-elementor .elementor-element-ec35d7d,
      #pxl-header-elementor .elementor-element-46d1c2c,
      #pxl-footer-elementor .elementor-element-7c35214,
      .woosc-area,
      .woosc-popup,
      #woosw_wishlist,
      .pxl-navigation-carousel {
        display: none !important;
      }

      .clients-page {
        background: #fff;
      }

      .clients-hero {
        position: relative;
        min-height: 480px;
        display: grid;
        align-items: end;
        overflow: hidden;
        background: #121315;
      }

      .clients-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(18, 19, 21, 0.9), rgba(18, 19, 21, 0.38)),
          url("/wp-content/uploads/2024/01/clientes-blueprints.jpg") center / cover no-repeat;
      }

      .clients-hero__inner,
      .clients-content {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .clients-hero__inner {
        position: relative;
        padding: 88px 0;
        color: #fff;
      }

      .clients-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        color: #d5dbe4;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .clients-eyebrow::before {
        content: "";
        width: 10px;
        height: 10px;
        background: #0B4F8A;
      }

      .clients-hero h1 {
        max-width: 760px;
        margin: 0;
        color: #fff;
        font-size: clamp(44px, 6vw, 84px);
        line-height: 1;
      }

      .clients-content {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
        gap: 54px;
        padding: 78px 0 96px;
      }

      .clients-copy h2,
      .clients-note h2 {
        margin: 0 0 24px;
        color: #121315;
        font-size: clamp(32px, 4vw, 52px);
        line-height: 1.12;
      }

      .clients-copy p,
      .clients-note p,
      .clients-note li {
        color: #626b76;
        font-size: 18px;
        line-height: 1.75;
      }

      .clients-copy p {
        margin: 0 0 22px;
      }

      .clients-sectors {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 32px;
      }

      .clients-sector {
        border-left: 5px solid #0B4F8A;
        background: #f5f8fb;
        padding: 20px;
        color: #121315;
        font-size: 18px;
        font-weight: 800;
      }

      .clients-note {
        align-self: start;
        border-top: 5px solid #0B4F8A;
        background: #121315;
        padding: 32px;
      }

      .clients-note h2,
      .clients-note p,
      .clients-note li {
        color: #fff;
      }

      .clients-note ul {
        margin: 22px 0 0;
        padding: 0;
        list-style: none;
      }

      .clients-note li {
        position: relative;
        padding-left: 24px;
        margin-bottom: 12px;
      }

      .clients-note li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 14px;
        width: 8px;
        height: 8px;
        background: #0B4F8A;
      }

      .clients-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 56px;
        margin-top: 28px;
        padding: 0 28px;
        background: #0B4F8A;
        color: #fff !important;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .pxl-scroll-top {
        width: auto !important;
        min-width: 132px !important;
        height: 48px !important;
        padding: 0 18px !important;
        border-radius: 999px !important;
        gap: 8px !important;
      }

      .pxl-scroll-top::after {
        content: "Volver arriba";
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .pxl-scroll-top svg {
        display: none !important;
      }

      @media (max-width: 900px) {
        .clients-content,
        .clients-sectors {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 767px) {
        #pxl-header-elementor .elementor-widget-pxl_logo,
        #pxl-header-elementor .pxl-logo,
        #pxl-header-elementor .pxl-logo a {
          width: 140px !important;
          min-width: 140px !important;
        }

        #pxl-header-elementor .pxl-logo img,
        #pxl-header-elementor img.diicsa-header-logo,
        #pxl-header-elementor img[src*="diccsA.png"] {
          width: 140px !important;
          height: 140px !important;
          min-width: 140px !important;
          min-height: 140px !important;
        }
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={headerHtmlToInject} />
    <main id="pxl-main" class="clients-page">
      <section class="clients-hero">
        <div class="clients-hero__inner">
          <div class="clients-eyebrow">Experiencia</div>
          <h1>Clientes</h1>
        </div>
      </section>

      <section class="clients-content">
        <article class="clients-copy">
          <h2>Relaciones de largo plazo para operaciones que no pueden detenerse.</h2>
          <p>
            Hemos colaborado con corporativos, plantas industriales, centros de entrenamiento y empresas que requieren
            continuidad, seguridad y respuesta tecnica.
          </p>
          <p>
            Nuestro trabajo se enfoca en relaciones de largo plazo y soluciones claras para cada operacion. DIICSA
            acompana a sus clientes con planeacion, supervision y capacidad de respuesta en campo.
          </p>
          <div class="clients-sectors">
            <div class="clients-sector">Corporativos</div>
            <div class="clients-sector">Plantas industriales</div>
            <div class="clients-sector">Centros de entrenamiento</div>
            <div class="clients-sector">Empresas con operacion continua</div>
          </div>
          <a class="clients-button" href="/contact-us/#cotizacion">Solicitar cotizacion</a>
        </article>

        <aside class="clients-note">
          <h2>Por documentar</h2>
          <p>
            La lista nominal de clientes queda pendiente para que el cliente confirme que empresas, proyectos y
            testimonios desea publicar.
          </p>
          <ul>
            <li>Nombre comercial autorizado</li>
            <li>Tipo de proyecto ejecutado</li>
            <li>Imagenes o logotipos con permiso de uso</li>
            <li>Resultados o alcance que pueda compartirse publicamente</li>
          </ul>
        </aside>
      </section>
    </main>
    <Fragment set:html={footerHtmlToInject} />
    <script is:inline>
      (() => {
        const sectionMap = {
          about: ".elementor-element-cf670d7",
          services: ".elementor-element-398cfb4"
        };

        const handleAnchorClick = (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const link = target?.closest('a[href^="#"]');
          if (!link) return;
          const hash = link.getAttribute("href");
          if (!hash || hash === "#") return;
          if (sectionMap[hash.replace("#", "")]) {
            event.preventDefault();
            event.stopPropagation();
            window.location.href = `/${hash}`;
          }
        };

        window.addEventListener("click", handleAnchorClick, true);
        document.addEventListener("click", handleAnchorClick, true);
      })();
    </script>
  </body>
</html>
