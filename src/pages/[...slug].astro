function applyTranslations(html: string) {
  let translated = html;
  for (const [pattern, replacement] of textReplacements) {
    translated = translated.replace(pattern, replacement);
  }
  return translated;
}

const translatedHeadHtml = applyTranslations(page.headHtml ?? "");
const translatedBodyHtml = applyTranslations(page.bodyHtml ?? "");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Fragment set:html={translatedHeadHtml} />
    <style is:global>
      /* Hide legacy Graviton menus that should never be visible on this clone. */
      .menu-menu-primary-container,
      [id^="menu-menu-primary"],
      [id^="menu-menu-mobile"],
      .pxl-header-elementor-sticky {
        display: none !important;
      }

      /* Temporarily hide the "Articulos y Noticias" block. */
      .elementor-element-ab40a8c {
        display: none !important;
      }

      /* Increase DIICSA top-left header logo by ~40% from current size. */
      #pxl-header-elementor .elementor-element-d9df9fe .pxl-logo img {
        max-height: 104px !important;
        width: auto !important;
      }

      @media (max-width: 1600px) {
        #pxl-header-elementor .elementor-element-d9df9fe .pxl-logo img {
          max-height: 95px !important;
        }
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={translatedBodyHtml} />
    <script is:inline>
      (() => {
        function hasOnePageMenu(scope) {
          return Boolean(scope?.querySelector('[id^="menu-menu-one-page"]'));
        }

        function removePrimaryMenus() {
          document.querySelectorAll('[id^="menu-menu-primary"], .menu-menu-primary-container').forEach((node) => {
            const section = node.closest("section.elementor-section");
            if (section && !hasOnePageMenu(section)) {
              section.remove();
              return;
            }

            const removeTarget =
              node.closest(".elementor-widget-pxl_menu") ??
              node.closest(".pxl-nav-menu") ??
              node.closest(".elementor-widget") ??
              node;
            removeTarget.remove();
          });
        }

        function removeMobileMenus() {
          document.querySelectorAll('[id^="menu-menu-mobile"]').forEach((node) => {
            const removeTarget =
              node.closest(".pxl-header-menu-scroll") ??
              node.closest(".pxl-header-menu") ??
              node.closest(".pxl-header-nav") ??
              node.closest(".elementor-widget") ??
              node;
            removeTarget.remove();
          });
        }

        function removeTopBarBrokenIcons() {
          const mainHeader = document.querySelector("#pxl-header-elementor .pxl-header-elementor-main");
          if (!mainHeader) return;

          mainHeader.querySelectorAll(".pxl-icon-list").forEach((list) => {
            if (!list.querySelector("i.fab")) return;

            const widget =
              list.closest(".elementor-widget-pxl_icon") ??
              list.closest(".elementor-widget") ??
              list;
            const wrap = widget.parentElement;

            widget.remove();

            // Remove the vertical divider that belongs to the same top-right icon area.
            wrap?.querySelectorAll(".elementor-widget-divider").forEach((divider) => {
              divider.remove();
            });
          });
        }

        function removeStickyHeaderClone() {
          document.querySelectorAll(".pxl-header-elementor-sticky").forEach((node) => {
            node.remove();
          });
        }

        function removeValuesSection() {
          document.querySelectorAll("section.elementor-section").forEach((section) => {
            const titles = Array.from(section.querySelectorAll("h5.pxl-item--title"))
              .map((node) => (node.textContent ?? "").replace(/\s+/g, " ").trim());
            const hasClientes = titles.includes("Clientes");
            const hasEmpleados = titles.includes("Empleados.");
            const hasComunidad = titles.includes("Comunidad");

            if (hasClientes && hasEmpleados && hasComunidad) {
              section.remove();
            }
          });
        }

        function removeFooterPlaceholderSocial() {
          const footer = document.querySelector("#pxl-footer-elementor");
          if (!footer) return;

          footer.querySelectorAll(".pxl-icon-list").forEach((list) => {
            const links = Array.from(list.querySelectorAll("a"));
            if (links.length < 5) return;

            const onlyPlaceholders = links.every((link) => {
              const href = (link.getAttribute("href") ?? "").trim().toLowerCase();
              return href === "" || href === "#";
            });

            if (!onlyPlaceholders) return;

            const removeTarget =
              list.closest(".elementor-widget-pxl_icon") ??
              list.closest(".elementor-widget") ??
              list;
            removeTarget.remove();
          });
        }

        function normalizeText(value) {
          return (value ?? "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/\s+/g, " ")
            .trim();
        }

        function removeLatestArticlesSection() {
          document.querySelectorAll("section.elementor-section").forEach((section) => {
            const titles = Array.from(section.querySelectorAll("h1, h2, h3, h4, h5, h6")).map((node) =>
              normalizeText(node.textContent)
            );
            const hasArticlesTitle = titles.some(
              (title) => title.includes("articulos y noticias") || title.includes("articles and news")
            );
            const hasPostCarousel = Boolean(
              section.querySelector(".elementor-widget-pxl_post_carousel, .pxl-post-carousel")
            );

            if (hasArticlesTitle && hasPostCarousel) {
              section.remove();
            }
          });
        }

        function cleanupLegacyMenus() {
          removeTopBarBrokenIcons();
          removeStickyHeaderClone();
          removePrimaryMenus();
          removeMobileMenus();
          removeValuesSection();
          removeFooterPlaceholderSocial();
          removeLatestArticlesSection();
        }

        let scheduled = false;
        function scheduleCleanup() {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            scheduled = false;
            cleanupLegacyMenus();
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", cleanupLegacyMenus, { once: true });
        } else {
          cleanupLegacyMenus();
        }

        const observer = new MutationObserver(scheduleCleanup);
        observer.observe(document.documentElement, { childList: true, subtree: true });

        window.addEventListener("scroll", scheduleCleanup, { passive: true });
      })();
    </script>
  </body>
</html>
