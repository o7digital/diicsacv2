function applyTranslations(html: string) {
  let translated = html;
  for (const [pattern, replacement] of textReplacements) {
    translated = translated.replace(pattern, replacement);
  }
  return translated;
}

function extractMetaDescription(html: string) {
  const match = html.match(/<meta[^>]+name=["']description["'][^>]*content=["']([^"']+)["'][^>]*>/i);
  return match?.[1]?.trim();
}

function extractOgImage(html: string) {
  const match = html.match(/<meta[^>]+property=["']og:image["'][^>]*content=["']([^"']+)["'][^>]*>/i);
  return match?.[1]?.trim();
}

const translatedHeadHtml = applyTranslations(page.headHtml ?? "");
const translatedBodyHtml = applyTranslations(page.bodyHtml ?? "");
const seoDescription = extractMetaDescription(translatedHeadHtml);
const seoImage = extractOgImage(translatedHeadHtml);
const headHtmlToInject = translatedHeadHtml;
const bodyHtmlToInject = translatedBodyHtml;
const seoTitle = applyTranslations(page.title ?? "DIICSA");
---
<MainLayout
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  bodyAttributes={bodyAttributes}
>
  <Fragment slot="head" set:html={headHtmlToInject} />
  <style is:global>
    /* Hide legacy Graviton menus that should never be visible on this clone. */
    .menu-menu-primary-container,
    [id^="menu-menu-primary"],
    [id^="menu-menu-mobile"],
    .pxl-header-elementor-sticky {
      display: none !important;
    }

    /* Temporarily hide the "Articulos y Noticias" block. */
    .elementor-element-ab40a8c {
      display: none !important;
    }

    /* Hide orange "ready to work together" info box card. */
    .elementor-element-14da8a8 {
      display: none !important;
    }

    /* Hide WooCommerce cart icon in header and cart sidebar panel. */
    #pxl-header-elementor .elementor-widget-icon_cart,
    #pxl-header-elementor .pxl-cart-sidebar-button,
    #pxl-cart-sidebar {
      display: none !important;
    }

    /* Hide the floating orange scroll-top circle at the right side/footer. */
    .pxl-scroll-top {
      display: none !important;
    }

    /* Hide buttons explicitly labeled "leer mas". */
    .pxl-button:has(.pxl--btn-text[data-text="leer mas" i]),
    .elementor-widget-pxl_button:has(.pxl--btn-text[data-text="leer mas" i]) {
      display: none !important;
    }

    /* Increase DIICSA top-left header logo by ~40% from current size. */
    #pxl-header-elementor .elementor-element-d9df9fe .pxl-logo img {
      max-height: 104px !important;
      width: auto !important;
    }

    @media (max-width: 1600px) {
      #pxl-header-elementor .elementor-element-d9df9fe .pxl-logo img {
        max-height: 95px !important;
      }
    }
  </style>
  <Fragment set:html={bodyHtmlToInject} />
  <script is:inline>
    (() => {
        function hasOnePageMenu(scope) {
          return Boolean(scope?.querySelector('[id^="menu-menu-one-page"]'));
        }

        function removePrimaryMenus() {
          document.querySelectorAll('[id^="menu-menu-primary"], .menu-menu-primary-container').forEach((node) => {
            const section = node.closest("section.elementor-section");
            if (section && !hasOnePageMenu(section)) {
              section.remove();
              return;
            }

            const removeTarget =
              node.closest(".elementor-widget-pxl_menu") ??
              node.closest(".pxl-nav-menu") ??
              node.closest(".elementor-widget") ??
              node;
            removeTarget.remove();
          });
        }

        function removeMobileMenus() {
          document.querySelectorAll('[id^="menu-menu-mobile"]').forEach((node) => {
            const removeTarget =
              node.closest(".pxl-header-menu-scroll") ??
              node.closest(".pxl-header-menu") ??
              node.closest(".pxl-header-nav") ??
              node.closest(".elementor-widget") ??
              node;
            removeTarget.remove();
          });
        }

        function removeTopBarBrokenIcons() {
          const mainHeader = document.querySelector("#pxl-header-elementor .pxl-header-elementor-main");
          if (!mainHeader) return;

          mainHeader.querySelectorAll(".pxl-icon-list").forEach((list) => {
            if (!list.querySelector("i.fab")) return;

            const widget =
              list.closest(".elementor-widget-pxl_icon") ??
              list.closest(".elementor-widget") ??
              list;
            const wrap = widget.parentElement;

            widget.remove();

            // Remove the vertical divider that belongs to the same top-right icon area.
            wrap?.querySelectorAll(".elementor-widget-divider").forEach((divider) => {
              divider.remove();
            });
          });
        }

        function removeStickyHeaderClone() {
          document.querySelectorAll(".pxl-header-elementor-sticky").forEach((node) => {
            node.remove();
          });
        }

        function removeValuesSection() {
          document.querySelectorAll("section.elementor-section").forEach((section) => {
            const titles = Array.from(section.querySelectorAll("h5.pxl-item--title"))
              .map((node) => (node.textContent ?? "").replace(/\s+/g, " ").trim());
            const hasClientes = titles.includes("Clientes");
            const hasEmpleados = titles.includes("Empleados.");
            const hasComunidad = titles.includes("Comunidad");

            if (hasClientes && hasEmpleados && hasComunidad) {
              section.remove();
            }
          });
        }

        function removeFooterPlaceholderSocial() {
          const footer = document.querySelector("#pxl-footer-elementor");
          if (!footer) return;

          footer.querySelectorAll(".pxl-icon-list").forEach((list) => {
            const links = Array.from(list.querySelectorAll("a"));
            if (links.length < 5) return;

            const onlyPlaceholders = links.every((link) => {
              const href = (link.getAttribute("href") ?? "").trim().toLowerCase();
              return href === "" || href === "#";
            });

            if (!onlyPlaceholders) return;

            const removeTarget =
              list.closest(".elementor-widget-pxl_icon") ??
              list.closest(".elementor-widget") ??
              list;
            removeTarget.remove();
          });
        }

        function removeHeaderCart() {
          document
            .querySelectorAll(
              "#pxl-header-elementor .elementor-widget-icon_cart, #pxl-header-elementor .pxl-cart-sidebar-button, #pxl-cart-sidebar"
            )
            .forEach((node) => {
              const removeTarget =
                node.closest(".elementor-widget-icon_cart") ??
                node.closest(".elementor-widget") ??
                node;
              removeTarget.remove();
            });
        }

        function removeScrollTopButton() {
          document.querySelectorAll(".pxl-scroll-top, a.pxl-scroll-top").forEach((node) => {
            node.remove();
          });
        }

        function normalizeText(value) {
          return (value ?? "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/\s+/g, " ")
            .trim();
        }

        function removeLatestArticlesSection() {
          document.querySelectorAll("section.elementor-section").forEach((section) => {
            const titles = Array.from(section.querySelectorAll("h1, h2, h3, h4, h5, h6")).map((node) =>
              normalizeText(node.textContent)
            );
            const hasArticlesTitle = titles.some(
              (title) => title.includes("articulos y noticias") || title.includes("articles and news")
            );
            const hasPostCarousel = Boolean(
              section.querySelector(".elementor-widget-pxl_post_carousel, .pxl-post-carousel")
            );

            if (hasArticlesTitle && hasPostCarousel) {
              section.remove();
            }
          });
        }

        function updateFooterLegalLinks() {
          const footer = document.querySelector("#pxl-footer-elementor");
          if (!footer) return;

          footer.querySelectorAll("p").forEach((paragraph) => {
            const links = Array.from(paragraph.querySelectorAll("a"));
            if (!links.length) return;

            const avisoLink = links.find((link) => normalizeText(link.textContent).includes("aviso de privacidad"));
            const terminosLink = links.find((link) =>
              normalizeText(link.textContent).includes("terminos y condiciones")
            );

            if (avisoLink) {
              const cleanAvisoLink = avisoLink.cloneNode(true);
              cleanAvisoLink.setAttribute("href", "/aviso-de-privacidad/");
              cleanAvisoLink.textContent = "Aviso de Privacidad";
              paragraph.replaceChildren(cleanAvisoLink);
            }

            terminosLink?.remove();
          });

          footer.querySelectorAll("a").forEach((link) => {
            if (normalizeText(link.textContent).includes("aviso de privacidad")) {
              link.setAttribute("href", "/aviso-de-privacidad/");
              link.textContent = "Aviso de Privacidad";
            }

            if (normalizeText(link.textContent).includes("terminos y condiciones")) {
              link.remove();
            }
          });
        }

        function removeContactProjectSection() {
          document.querySelectorAll("section.elementor-section").forEach((section) => {
            const text = normalizeText(section.textContent);
            const hasMainTitle =
              text.includes("dejanos hacer tu proyecto") || text.includes("let us do your project");
            const hasContactHeader = text.includes("contacta nos") || text.includes("contactanos");
            const hasContactCards =
              text.includes("consulta rapida") &&
              text.includes("llamanos de vuelta") &&
              text.includes("contacto por email") &&
              text.includes("bajar nuestro brochure");

            if ((hasMainTitle && hasContactHeader) || hasContactCards) {
              section.remove();
            }
          });
        }

        function removeReadyToWorkWidgets() {
          document.querySelectorAll(".elementor-widget-pxl_info_box, .pxl-info-box1").forEach((node) => {
            const widget = node.closest(".elementor-widget-pxl_info_box") ?? node;
            const text = normalizeText(widget.textContent);
            const isReadyBox =
              text.includes("estas listo para trabajar junto a nosotros") ||
              text.includes("unete a nosotros hoy") ||
              text.includes("are you ready to work together");

            if (isReadyBox) {
              widget.remove();
            }
          });
        }

        function removeLeerMasButtons() {
          document.querySelectorAll(".pxl--btn-text, .pxl-button a.btn").forEach((node) => {
            const text = normalizeText(node.textContent);
            const dataText = normalizeText(node.getAttribute?.("data-text"));
            const isLeerMas = text === "leer mas" || dataText === "leer mas";
            if (!isLeerMas) return;

            const removeTarget =
              node.closest(".elementor-widget-pxl_button") ??
              node.closest(".pxl-button") ??
              node;
            removeTarget.remove();
          });
        }

        function cleanupLegacyMenus() {
          removeTopBarBrokenIcons();
          removeStickyHeaderClone();
          removePrimaryMenus();
          removeMobileMenus();
          removeValuesSection();
          removeFooterPlaceholderSocial();
          removeLatestArticlesSection();
          removeContactProjectSection();
          removeReadyToWorkWidgets();
          removeLeerMasButtons();
          removeHeaderCart();
          removeScrollTopButton();
          updateFooterLegalLinks();
        }

        let scheduled = false;
        function scheduleCleanup() {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            scheduled = false;
            cleanupLegacyMenus();
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", cleanupLegacyMenus, { once: true });
        } else {
          cleanupLegacyMenus();
        }

        const observer = new MutationObserver(scheduleCleanup);
        observer.observe(document.documentElement, { childList: true, subtree: true });

        window.addEventListener("scroll", scheduleCleanup, { passive: true });
      })();
  </script>
</MainLayout>
