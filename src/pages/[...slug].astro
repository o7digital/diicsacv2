---
import snapshot from "../data/wp-snapshot.json";

export function getStaticPaths() {
  return snapshot.pages.map((page) => {
    const normalized = page.path.replace(/^\/+|\/+$/g, "");
    return {
      params: {
        slug: normalized === "" ? undefined : normalized
      },
      props: { page }
    };
  });
}

const { page } = Astro.props;
const bodyAttributes = page.bodyAttributes ?? {};
const headHtmlToInject = page.headHtml ?? "";
const bodyHtmlToInject = page.bodyHtml ?? "";
---
<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={headHtmlToInject} />
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyHtmlToInject} />
  </body>
</html>
