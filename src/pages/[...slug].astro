---
import snapshot from "../data/wp-snapshot.json";

export function getStaticPaths() {
  return snapshot.pages.map((page) => {
    const normalized = page.path.replace(/^\/+|\/+$/g, "");
    return {
      params: {
        slug: normalized === "" ? undefined : normalized
      },
      props: { page }
    };
  });
}

const { page } = Astro.props;
const bodyAttributes = page.bodyAttributes ?? {};
const textReplacements: Array<[RegExp, string]> = [
  [
    /Our post-construction services gives you peace of mind knowing that we are still here for you even after\./gi,
    "Nuestros servicios de posconstrucción te brindan tranquilidad, sabiendo que seguimos aquí para ti incluso después."
  ],
  [
    /Graviton Construction team can renovate any part of your home\. Here are some of the most commonly\./gi,
    "Nuestro equipo puede renovar cualquier parte de tu proyecto. Estas son algunas de las soluciones más comunes."
  ],
  [
    /Graviton offers both emergency roof leak and non-emergency roof repair services to both commercial\./gi,
    "Ofrecemos servicios de reparación de techos, tanto de emergencia como no urgentes, para proyectos comerciales."
  ],
  [
    /Graviton offers both emergency roof and non-emergency roof repair services commercial\./gi,
    "Ofrecemos servicios de reparación de techos, tanto de emergencia como no urgentes, para proyectos comerciales."
  ],
  [/view more/gi, "VER MÁS"],
  [/Subscribe Newsletter/gi, "Suscríbete al boletín"],
  [/Type Your Search Words\.\.\./gi, "Escribe tu búsqueda..."],
  [/Copyright\s*©\s*2024/gi, "Copyright © 2026"]
];

function applyTextReplacements(html: string) {
  let output = html;
  for (const [pattern, replacement] of textReplacements) {
    output = output.replace(pattern, replacement);
  }
  return output;
}

const translatedHeadHtml = applyTextReplacements(page.headHtml ?? "");
const sanitizedBodyHtml = applyTextReplacements((page.bodyHtml ?? "").replace(/<script\b[\s\S]*?<\/script>/gi, ""));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Fragment set:html={translatedHeadHtml} />
    <style is:global>
      /* Keep DIICSACV one-page navigation and hide recurring demo/legacy menus. */
      [id^="menu-menu-primary"],
      [id^="menu-menu-mobile"],
      .menu-menu-primary-container {
        display: none !important;
      }

      /* Hide blog/news blocks for now. */
      .post-layout-post-2,
      .pxl-post-carousel2 {
        display: none !important;
      }

      /* Hide the Clients/Employees/Community cards section. */
      section[data-id="3029aa4"] {
        display: none !important;
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={sanitizedBodyHtml} />
    <script is:inline>
      (() => {
        const recurringLabelRegex = /\b(home|pages?|services?|projects?|blog|contact us|get a quote)\b/i;

        function hasOnePageMenu(section) {
          return Boolean(section?.querySelector('[id^="menu-menu-one-page"]'));
        }

        function removePrimaryMenuBlock(node) {
          if (!node) return;
          const section = node.closest(".elementor-section");
          const removeTarget =
            (!hasOnePageMenu(section) && section) ??
            node.closest(".menu-menu-primary-container") ??
            node.closest(".elementor-widget") ??
            node.closest(".pxl-nav-menu") ??
            node.closest(".pxl-header-menu") ??
            node.closest("#pxl-header-elementor") ??
            node;
          removeTarget.remove();
        }

        function removeMobileMenuBlock(node) {
          if (!node) return;
          const removeTarget =
            node.closest(".pxl-header-menu-scroll") ??
            node.closest(".pxl-header-menu") ??
            node.closest(".pxl-header-nav") ??
            node.closest(".elementor-widget") ??
            node.closest(".pxl-nav-menu") ??
            node.closest("#pxl-header-elementor") ??
            node;
          removeTarget.remove();
        }

        function removeGravitonLogoBlocks() {
          const gravitonLogoSelector = [
            'img[src*="/wp-content/themes/graviton/assets/img/logo"]',
            'img[src*="themes/graviton/assets/img/logo"]'
          ].join(",");

          document.querySelectorAll(gravitonLogoSelector).forEach((logo) => {
            const removeTarget =
              logo.closest("#pxl-header-elementor") ??
              logo.closest(".pxl-header-elementor-main") ??
              logo.closest(".elementor-section") ??
              logo.closest(".elementor-widget") ??
              logo;
            removeTarget.remove();
          });
        }

        function removeRecurringMenus() {
          const primarySelectors = ['[id^="menu-menu-primary"]', ".menu-menu-primary-container"];
          const mobileSelectors = ['[id^="menu-menu-mobile"]'];

          primarySelectors.forEach((selector) => {
            document.querySelectorAll(selector).forEach((menu) => {
              removePrimaryMenuBlock(menu);
            });
          });

          mobileSelectors.forEach((selector) => {
            document.querySelectorAll(selector).forEach((menu) => {
              removeMobileMenuBlock(menu);
            });
          });

          // Safety net: keep only one-page menus in pxl menu blocks.
          document.querySelectorAll("ul.pxl-menu-primary").forEach((menu) => {
            const id = menu.id ?? "";
            const isOnePageMenu = id.startsWith("menu-menu-one-page");
            const likelyRecurringByLabel = recurringLabelRegex.test(menu.textContent ?? "");
            if (isOnePageMenu) return;
            if (!likelyRecurringByLabel && id !== "") return;
            const removeTarget =
              menu.closest(".menu-menu-primary-container") ??
              menu.closest(".pxl-header-nav") ??
              menu.closest(".pxl-nav-menu") ??
              menu.closest(".elementor-widget") ??
              menu;
            removeTarget.remove();
          });
        }

        function removeBlogMenusAndSections() {
          const blogHeadingRegex = /(art[íi]culos?\s+y\s+noticias|latest\s+news|blog)/i;

          document.querySelectorAll("li.menu-item, li").forEach((item) => {
            const text = (item.textContent ?? "").replace(/\s+/g, " ").trim();
            if (/\bblog\b/i.test(text)) {
              item.remove();
            }
          });

          document
            .querySelectorAll(".post-layout-post-2, .pxl-post-carousel2, .elementor-widget-pxl_post")
            .forEach((node) => {
              const removeTarget =
                node.closest(".elementor-section") ??
                node.closest(".elementor-widget") ??
                node;
              removeTarget.remove();
            });

          document.querySelectorAll(".pxl-item--title, h1, h2, h3").forEach((title) => {
            const text = (title.textContent ?? "").replace(/\s+/g, " ").trim();
            if (!blogHeadingRegex.test(text)) return;
            const removeTarget =
              title.closest(".elementor-section") ??
              title.closest(".elementor-widget") ??
              title;
            removeTarget.remove();
          });
        }

        function patchCopyrightYear() {
          document.querySelectorAll("p, span, div, a").forEach((el) => {
            const text = el.textContent ?? "";
            if (!/Copyright\s*©\s*2024/i.test(text)) return;
            el.textContent = text.replace(/Copyright\s*©\s*2024/gi, "Copyright © 2026");
          });
        }

        function removeClientsEmployeesCommunitySection() {
          document.querySelectorAll('section[data-id="3029aa4"]').forEach((section) => {
            section.remove();
          });

          const cardsTitleRegex = /^(clientes\.?|empleados\.?|comunidad)$/i;
          document.querySelectorAll(".pxl-icon-box2 .pxl-item--title").forEach((title) => {
            const text = (title.textContent ?? "").replace(/\s+/g, " ").trim();
            if (!cardsTitleRegex.test(text)) return;
            const removeTarget = title.closest(".elementor-section");
            removeTarget?.remove();
          });
        }

        function cleanupMenus() {
          removeRecurringMenus();
          removeGravitonLogoBlocks();
          removeBlogMenusAndSections();
          patchCopyrightYear();
          removeClientsEmployeesCommunitySection();
        }

        let cleanupScheduled = false;
        function scheduleCleanup() {
          if (cleanupScheduled) return;
          cleanupScheduled = true;
          requestAnimationFrame(() => {
            cleanupScheduled = false;
            cleanupMenus();
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", cleanupMenus, { once: true });
        } else {
          cleanupMenus();
        }

        const observer = new MutationObserver(() => {
          scheduleCleanup();
        });

        if (document.body) {
          observer.observe(document.body, { childList: true, subtree: true });
        }

        window.addEventListener("scroll", scheduleCleanup, { passive: true });
        window.addEventListener("resize", scheduleCleanup, { passive: true });
      })();
    </script>
  </body>
</html>
