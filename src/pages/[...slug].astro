---
import snapshot from "../data/wp-snapshot.json";
import { applySiteHead, applySiteHtml } from "../lib/site-html";

export function getStaticPaths() {
  const customServicePaths = new Set([
    "/service/edificacion-habilitacion",
    "/service/obra-electrica-alta-y-media",
    "/service/obra-de-procesos-mecanicos",
    "/service/obra-civil-en-general"
  ]);

  return snapshot.pages.filter((page) => page.path !== "/history" && !customServicePaths.has(page.path)).map((page) => {
    const normalized = page.path.replace(/^\/+|\/+$/g, "");
    return {
      params: {
        slug: normalized === "" ? undefined : normalized
      },
      props: { page }
    };
  });
}

const { page } = Astro.props;
const bodyAttributes = page.bodyAttributes ?? {};
const headHtmlToInject = applySiteHead(page.headHtml ?? "");
const bodyHtmlToInject = applySiteHtml(page.bodyHtml ?? "");
---
<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={headHtmlToInject} />
    <style is:global>
      #pxl-header-elementor .pxl-header-elementor-sticky,
      #pxl-header-elementor.pxl-header-fixed,
      #pxl-header-elementor.pxl-header-sticky {
        display: none !important;
      }

      .elementor-73 .elementor-element.elementor-element-14da8a8 > .elementor-widget-container {
        background-color: #0B4F8A !important;
        background-image:
          linear-gradient(135deg, rgba(11, 79, 138, 0.96), rgba(8, 58, 102, 0.9)),
          url("/wp-content/uploads/2024/01/bg-h2-2.jpg") !important;
        background-blend-mode: multiply, luminosity;
      }

      #pxl-header-elementor .elementor-widget-pxl_logo,
      #pxl-header-elementor .pxl-logo,
      #pxl-header-elementor .pxl-logo a {
        width: 180px !important;
        min-width: 180px !important;
        max-width: none !important;
      }

      #pxl-header-elementor .pxl-logo img,
      #pxl-header-elementor img.diicsa-header-logo,
      #pxl-header-elementor img[src*="diccsA.png"] {
        display: block !important;
        width: 180px !important;
        height: 180px !important;
        min-width: 180px !important;
        min-height: 180px !important;
        max-width: none !important;
        max-height: none !important;
        object-fit: contain !important;
      }

      #pxl-header-elementor .elementor-element-ec35d7d,
      #pxl-header-elementor .elementor-element-46d1c2c,
      #pxl-header-elementor .elementor-widget-pxl_language_switch,
      #pxl-header-elementor .elementor-widget-pxl_arrow_carousel,
      #pxl-footer-elementor .elementor-element-7c35214,
      .woosc-area,
      .woosc-popup,
      #woosw_wishlist,
      .pxl-navigation-carousel {
        display: none !important;
      }

      .pxl-slider-carousel .pxl-item--link {
        display: none !important;
      }

      #pxl-footer-elementor .elementor-widget-pxl_logo .pxl-logo img {
        width: 90px !important;
        height: 90px !important;
        max-width: none !important;
        object-fit: contain !important;
      }

      img[src$="/G2.png"],
      img[src*="/G2.png"] {
        content: url("/wp-content/uploads/2024/01/G2-blue.png") !important;
      }

      .pxl-team .pxl-swiper-slide,
      .pxl-team .pxl-item--inner,
      .pxl-team .pxl-item--image,
      .pxl-team .img-thumb {
        opacity: 1 !important;
        visibility: visible !important;
      }

      .pxl-team .pxl-item--image,
      .pxl-team .img-thumb {
        min-height: 395px !important;
        background: #eef2f5 !important;
      }

      .pxl-team .pxl-item--image img,
      .pxl-team .img-thumb img {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 395px !important;
        object-fit: cover !important;
        opacity: 1 !important;
        visibility: visible !important;
      }

      .pxl-icon-box2 .pxl-item--icon {
        display: none !important;
      }

      .pxl-scroll-top {
        width: auto !important;
        min-width: 132px !important;
        height: 48px !important;
        padding: 0 18px !important;
        border-radius: 999px !important;
        gap: 8px !important;
      }

      .pxl-scroll-top::after {
        content: "Volver arriba";
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .pxl-scroll-top svg {
        display: none !important;
      }

      @media (max-width: 767px) {
        #pxl-header-elementor .elementor-widget-pxl_logo,
        #pxl-header-elementor .pxl-logo,
        #pxl-header-elementor .pxl-logo a {
          width: 140px !important;
          min-width: 140px !important;
        }

        #pxl-header-elementor .pxl-logo img,
        #pxl-header-elementor img.diicsa-header-logo,
        #pxl-header-elementor img[src*="diccsA.png"] {
          width: 140px !important;
          height: 140px !important;
          min-width: 140px !important;
          min-height: 140px !important;
        }
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyHtmlToInject} />
    <script is:inline>
      (() => {
        const sectionMap = {
          about: ".elementor-element-cf670d7",
          services: ".elementor-element-398cfb4",
          projects: ".elementor-element-59ae6b1",
          blog: ".elementor-element-101e5ed"
        };

        const setSectionIds = () => {
          Object.entries(sectionMap).forEach(([id, selector]) => {
            const section = document.querySelector(selector);
            if (section) {
              section.id = id;
              section.style.scrollMarginTop = "170px";
            }
          });
        };

        const scrollToHash = (hash) => {
          const id = hash.replace("#", "");
          const target = document.getElementById(id) || document.querySelector(sectionMap[id]);
          if (!target) return false;
          const top = target.getBoundingClientRect().top + window.scrollY - 120;
          window.scrollTo({ top, behavior: "smooth" });
          history.replaceState(null, "", `#${id}`);
          return true;
        };

        const handleAnchorClick = (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const link = target?.closest('a[href^="#"]');
          if (!link) return;
          const hash = link.getAttribute("href");
          if (!hash || hash === "#") return;
          if (scrollToHash(hash)) {
            event.preventDefault();
            event.stopPropagation();
          } else if (sectionMap[hash.replace("#", "")]) {
            event.preventDefault();
            event.stopPropagation();
            window.location.href = `/${hash}`;
          }
        };

        const ready = () => {
          setSectionIds();
          if (window.location.hash) {
            [120, 450, 900].forEach((delay) => setTimeout(() => scrollToHash(window.location.hash), delay));
          }
          window.addEventListener("click", handleAnchorClick, true);
          document.addEventListener("click", handleAnchorClick, true);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", ready);
        } else {
          ready();
        }
      })();
    </script>
  </body>
</html>
