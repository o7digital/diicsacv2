---
import snapshot from "../../data/wp-snapshot.json";
import { services } from "../../data/services";

export function getStaticPaths() {
  return Object.keys(services).map((slug) => ({
    params: { slug },
    props: { service: services[slug] }
  }));
}

const { service } = Astro.props;
const shellPage = snapshot.pages.find((item) => item.path === "/") ?? snapshot.pages[0];
const bodyAttributes = shellPage.bodyAttributes ?? {};
const headHtmlToInject = shellPage.headHtml ?? "";
const shellBodyHtml = shellPage.bodyHtml ?? "";
const mainMarker = '<div id="pxl-main">';
const footerMarker = '<footer id="pxl-footer-elementor"';
const mainIndex = shellBodyHtml.indexOf(mainMarker);
const footerIndex = shellBodyHtml.indexOf(footerMarker);
const headerHtmlToInject = mainIndex >= 0 ? shellBodyHtml.slice(0, mainIndex) : "";
const footerHtmlToInject = footerIndex >= 0 ? shellBodyHtml.slice(footerIndex) : "";
---

<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={headHtmlToInject} />
    <title>{service.title} | DIICSA</title>
    <meta name="description" content={service.summary} />
    <style is:global>
      #pxl-header-elementor .pxl-header-elementor-sticky,
      #pxl-header-elementor.pxl-header-fixed,
      #pxl-header-elementor.pxl-header-sticky {
        display: none !important;
      }

      #pxl-header-elementor .elementor-widget-pxl_logo,
      #pxl-header-elementor .pxl-logo,
      #pxl-header-elementor .pxl-logo a {
        width: 180px !important;
        min-width: 180px !important;
        max-width: none !important;
      }

      #pxl-header-elementor .pxl-logo img,
      #pxl-header-elementor img.diicsa-header-logo,
      #pxl-header-elementor img[src*="diccsA.png"] {
        display: block !important;
        width: 180px !important;
        height: 180px !important;
        min-width: 180px !important;
        min-height: 180px !important;
        max-width: none !important;
        max-height: none !important;
        object-fit: contain !important;
      }

      #pxl-header-elementor .elementor-element-ec35d7d,
      #pxl-header-elementor .elementor-element-46d1c2c,
      #pxl-footer-elementor .elementor-element-7c35214,
      .woosc-area,
      .woosc-popup,
      #woosw_wishlist,
      .pxl-navigation-carousel {
        display: none !important;
      }

      .service-detail {
        background: #fff;
      }

      .service-hero {
        position: relative;
        min-height: 500px;
        display: grid;
        align-items: end;
        overflow: hidden;
        background: #121315;
      }

      .service-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(18, 19, 21, 0.9), rgba(18, 19, 21, 0.38)),
          var(--service-image) center / cover no-repeat;
      }

      .service-hero__inner,
      .service-content {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .service-hero__inner {
        position: relative;
        padding: 90px 0;
        color: #fff;
      }

      .service-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        color: #d5dbe4;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .service-eyebrow::before {
        content: "";
        width: 10px;
        height: 10px;
        background: #0B4F8A;
      }

      .service-hero h1 {
        max-width: 820px;
        margin: 0;
        color: #fff;
        font-size: clamp(44px, 6vw, 82px);
        line-height: 1.02;
      }

      .service-hero p {
        max-width: 760px;
        margin: 24px 0 0;
        color: #e4e8ed;
        font-size: 20px;
        line-height: 1.7;
      }

      .service-content {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
        gap: 54px;
        padding: 76px 0 96px;
      }

      .service-copy h2,
      .service-side h2 {
        margin: 0 0 22px;
        color: #121315;
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1.15;
      }

      .service-copy p,
      .service-copy li,
      .service-side li {
        color: #626b76;
        font-size: 18px;
        line-height: 1.75;
      }

      .service-copy ul,
      .service-side ul {
        margin: 24px 0 0;
        padding: 0;
        list-style: none;
      }

      .service-copy li,
      .service-side li {
        position: relative;
        padding-left: 24px;
        margin-bottom: 14px;
      }

      .service-copy li::before,
      .service-side li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 14px;
        width: 8px;
        height: 8px;
        background: #0B4F8A;
      }

      .service-side {
        align-self: start;
        border-top: 5px solid #0B4F8A;
        background: #f5f8fb;
        padding: 32px;
      }

      .service-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 34px;
      }

      .service-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 56px;
        padding: 0 28px;
        background: #0B4F8A;
        color: #fff !important;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .service-button--light {
        background: #eef2f6;
        color: #121315 !important;
      }

      .pxl-scroll-top {
        width: auto !important;
        min-width: 132px !important;
        height: 48px !important;
        padding: 0 18px !important;
        border-radius: 999px !important;
        gap: 8px !important;
      }

      .pxl-scroll-top::after {
        content: "Volver arriba";
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .pxl-scroll-top svg {
        display: none !important;
      }

      @media (max-width: 900px) {
        .service-content {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 767px) {
        #pxl-header-elementor .elementor-widget-pxl_logo,
        #pxl-header-elementor .pxl-logo,
        #pxl-header-elementor .pxl-logo a {
          width: 140px !important;
          min-width: 140px !important;
        }

        #pxl-header-elementor .pxl-logo img,
        #pxl-header-elementor img.diicsa-header-logo,
        #pxl-header-elementor img[src*="diccsA.png"] {
          width: 140px !important;
          height: 140px !important;
          min-width: 140px !important;
          min-height: 140px !important;
        }
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={headerHtmlToInject} />
    <main id="pxl-main" class="service-detail">
      <section class="service-hero" style={`--service-image: url("${service.image}")`}>
        <div class="service-hero__inner">
          <div class="service-eyebrow">{service.eyebrow}</div>
          <h1>{service.title}</h1>
          <p>{service.summary}</p>
        </div>
      </section>

      <section class="service-content">
        <article class="service-copy">
          <h2>Descripcion del servicio</h2>
          <p>{service.intro}</p>
          <ul>
            {service.includes.map((item) => <li>{item}</li>)}
          </ul>
          <div class="service-actions">
            <a class="service-button" href="/contact-us/#cotizacion">Solicitar cotizacion</a>
            <a class="service-button service-button--light" href="/#services">Ver mas servicios</a>
          </div>
        </article>

        <aside class="service-side">
          <h2>Beneficios</h2>
          <ul>
            {service.benefits.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </section>
    </main>
    <Fragment set:html={footerHtmlToInject} />
    <script is:inline>
      (() => {
        const sectionMap = {
          about: ".elementor-element-cf670d7",
          services: ".elementor-element-398cfb4",
          projects: ".elementor-element-59ae6b1",
          blog: ".elementor-element-101e5ed"
        };

        const handleAnchorClick = (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const link = target?.closest('a[href^="#"]');
          if (!link) return;
          const hash = link.getAttribute("href");
          if (!hash || hash === "#") return;
          if (sectionMap[hash.replace("#", "")]) {
            event.preventDefault();
            event.stopPropagation();
            window.location.href = `/${hash}`;
          }
        };

        window.addEventListener("click", handleAnchorClick, true);
        document.addEventListener("click", handleAnchorClick, true);
      })();
    </script>
  </body>
</html>
