---
import snapshot from "../data/wp-snapshot.json";

const shellPage = snapshot.pages.find((item) => item.path === "/") ?? snapshot.pages[0];
const bodyAttributes = shellPage.bodyAttributes ?? {};
const headHtmlToInject = shellPage.headHtml ?? "";
const shellBodyHtml = shellPage.bodyHtml ?? "";
const mainMarker = '<div id="pxl-main">';
const footerMarker = '<footer id="pxl-footer-elementor"';
const mainIndex = shellBodyHtml.indexOf(mainMarker);
const footerIndex = shellBodyHtml.indexOf(footerMarker);
const headerHtmlToInject = mainIndex >= 0 ? shellBodyHtml.slice(0, mainIndex) : "";
const footerHtmlToInject = footerIndex >= 0 ? shellBodyHtml.slice(footerIndex) : "";
---

<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={headHtmlToInject} />
    <title>Historia | DIICSA</title>
    <meta
      name="description"
      content="DIICSA es una empresa 100% mexicana fundada en 2002, especializada en diseno, construccion y mantenimiento integral."
    />
    <style is:global>
      #pxl-header-elementor .pxl-header-elementor-sticky,
      #pxl-header-elementor.pxl-header-fixed,
      #pxl-header-elementor.pxl-header-sticky {
        display: none !important;
      }

      #pxl-header-elementor .elementor-widget-pxl_logo,
      #pxl-header-elementor .pxl-logo,
      #pxl-header-elementor .pxl-logo a {
        width: 180px !important;
        min-width: 180px !important;
        max-width: none !important;
      }

      #pxl-header-elementor .pxl-logo img,
      #pxl-header-elementor img.diicsa-header-logo,
      #pxl-header-elementor img[src*="diccsA.png"] {
        display: block !important;
        width: 180px !important;
        height: 180px !important;
        min-width: 180px !important;
        min-height: 180px !important;
        max-width: none !important;
        max-height: none !important;
        object-fit: contain !important;
      }

      #pxl-header-elementor .elementor-element-ec35d7d,
      #pxl-header-elementor .elementor-element-46d1c2c,
      #pxl-footer-elementor .elementor-element-7c35214,
      .woosc-area,
      .woosc-popup,
      #woosw_wishlist,
      .pxl-navigation-carousel {
        display: none !important;
      }

      .history-page {
        background: #fff;
      }

      .history-hero {
        position: relative;
        min-height: 460px;
        display: grid;
        align-items: end;
        overflow: hidden;
        background: #121315;
      }

      .history-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(18, 19, 21, 0.9), rgba(18, 19, 21, 0.42)),
          url("/wp-content/uploads/2024/01/ptt-history.webp") center / cover no-repeat;
      }

      .history-hero__inner,
      .history-content {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .history-hero__inner {
        position: relative;
        padding: 84px 0;
        color: #fff;
      }

      .history-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        color: #d5dbe4;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .history-eyebrow::before {
        content: "";
        width: 10px;
        height: 10px;
        background: #0B4F8A;
      }

      .history-hero h1 {
        max-width: 760px;
        margin: 0;
        color: #fff;
        font-size: clamp(44px, 6vw, 84px);
        line-height: 1;
      }

      .history-content {
        display: grid;
        grid-template-columns: 0.95fr 1.35fr;
        gap: 56px;
        padding: 78px 0 96px;
      }

      .history-card {
        align-self: start;
        background: #0B4F8A;
        color: #fff;
        padding: 36px;
      }

      .history-card strong {
        display: block;
        font-size: 72px;
        line-height: 0.95;
      }

      .history-card span {
        display: block;
        margin-top: 14px;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .history-copy h2 {
        margin: 0 0 24px;
        color: #121315;
        font-size: clamp(32px, 4vw, 52px);
        line-height: 1.12;
      }

      .history-copy p {
        margin: 0 0 22px;
        color: #666;
        font-size: 18px;
        line-height: 1.8;
      }

      .history-highlight {
        margin-top: 34px;
        border-left: 6px solid #0B4F8A;
        background: #f4f7fb;
        padding: 28px 30px;
        color: #121315;
        font-size: 22px;
        font-weight: 800;
        line-height: 1.55;
      }

      .history-actions {
        margin-top: 36px;
      }

      .history-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 56px;
        padding: 0 28px;
        background: #0B4F8A;
        color: #fff !important;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .pxl-scroll-top {
        width: auto !important;
        min-width: 132px !important;
        height: 48px !important;
        padding: 0 18px !important;
        border-radius: 999px !important;
        gap: 8px !important;
      }

      .pxl-scroll-top::after {
        content: "Volver arriba";
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .pxl-scroll-top svg {
        display: none !important;
      }

      @media (max-width: 900px) {
        .history-content {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 767px) {
        #pxl-header-elementor .elementor-widget-pxl_logo,
        #pxl-header-elementor .pxl-logo,
        #pxl-header-elementor .pxl-logo a {
          width: 140px !important;
          min-width: 140px !important;
        }

        #pxl-header-elementor .pxl-logo img,
        #pxl-header-elementor img.diicsa-header-logo,
        #pxl-header-elementor img[src*="diccsA.png"] {
          width: 140px !important;
          height: 140px !important;
          min-width: 140px !important;
          min-height: 140px !important;
        }
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={headerHtmlToInject} />
    <main id="pxl-main" class="history-page">
      <section class="history-hero">
        <div class="history-hero__inner">
          <div class="history-eyebrow">Quienes somos</div>
          <h1>Historia DIICSA</h1>
        </div>
      </section>

      <section class="history-content">
        <aside class="history-card">
          <strong>2002</strong>
          <span>Fundacion de DIICSA</span>
        </aside>

        <article class="history-copy">
          <h2>Empresa mexicana con experiencia tecnica y enfoque practico.</h2>
          <p>
            DIICSA es una empresa 100% mexicana fundada en 2002, especializada en diseno, construccion y mantenimiento
            integral a empresas y particulares.
          </p>
          <p>
            Actualmente tenemos presencia en la Republica Mexicana, respaldando proyectos con experiencia tecnica,
            capacidad operativa y una forma de trabajo enfocada en resolver con orden, calidad y seguimiento.
          </p>
          <p>
            Nuestro equipo acompana cada proyecto desde la planeacion hasta la ejecucion, integrando servicios de obra
            civil, obra electrica, procesos mecanicos, rehabilitacion, habilitacion y mantenimiento industrial.
          </p>
          <div class="history-highlight">
            Construimos relaciones de largo plazo a traves de trabajo responsable, comunicacion clara y soluciones
            alineadas a las necesidades reales de cada cliente.
          </div>
          <div class="history-actions">
            <a class="history-button" href="/contact-us/#cotizacion">Solicitar cotizacion</a>
          </div>
        </article>
      </section>
    </main>
    <Fragment set:html={footerHtmlToInject} />
    <script is:inline>
      (() => {
        const sectionMap = {
          about: ".elementor-element-cf670d7",
          services: ".elementor-element-398cfb4",
          projects: ".elementor-element-59ae6b1",
          blog: ".elementor-element-101e5ed"
        };

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const link = target?.closest('a[href^="#"]');
          if (!link) return;
          const hash = link.getAttribute("href");
          if (!hash || hash === "#") return;
          if (sectionMap[hash.replace("#", "")]) {
            event.preventDefault();
            event.stopPropagation();
            window.location.href = `/${hash}`;
          }
        }, true);
      })();
    </script>
  </body>
</html>
