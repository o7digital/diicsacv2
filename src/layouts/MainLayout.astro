---
/**
 * Layout principal pour toutes les pages
 * Inclut SEO, Open Graph, Structured Data
 */
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
  bodyAttributes?: Record<string, string>;
}

const {
  title,
  description,
  image = "https://diicsacv.com/og-image.jpg",
  robots,
  bodyAttributes = {}
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      canonicalUrl={Astro.url.pathname}
      robots={robots}
    />
    <StructuredData />
    <slot name="head" />
  </head>
  <body {...bodyAttributes}>
    <slot />
  </body>
</html>
