---
/**
 * Layout principal pour toutes les pages
 * Inclut SEO, Open Graph, Structured Data
 */
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
  bodyAttributes?: Record<string, string>;
}

const {
  title,
  description,
  image = "https://diicsacv.com/og-image.jpg",
  robots,
  bodyAttributes = {}
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      canonicalUrl={Astro.url.pathname}
      robots={robots}
    />
    <StructuredData />
    <slot name="head" />
    <!-- Estilos globales -->
    <style is:global>
      :root {
        --bg: #0f131d;
        --card: #ffffff;
        --text: #1a1f2b;
        --muted: #5a6475;
        --accent: #f15a1e;
        --line: #e8ebf0;
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      body {
        background: var(--bg);
        color: var(--text);
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      /* Performance: Lazy loading */
      img[loading="lazy"] {
        background-color: #f0f0f0;
      }
    </style>
  </head>
  <body {...bodyAttributes}>
    <slot />
  </body>
</html>
